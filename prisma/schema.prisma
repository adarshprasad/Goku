generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           String    @default("CUSTOMER")
  phone          String?
  gstin          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  accounts       Account[]
  sessions       Session[]
  addresses      Address[]
  orders         Order[]
  wishlist       WishlistItem[]
  reviews        Review[]
  carts          Cart[]
  measurements   MeasurementProfile[]
  returnRequests ReturnRequest[]
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String  @default("IN")
  isDefault  Boolean @default(false)
  orders     Order[]
}

model Collection {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  tagline     String
  description String
  image       String
  sortOrder   Int                  @default(0)
  products    CollectionProduct[]
}

model Product {
  id              String               @id @default(cuid())
  slug            String               @unique
  sku             String               @unique
  name            String
  type            String
  description     String
  craftStory      String
  artisanNote     String?
  giTag           String?
  pricePaise      Int
  mrpPaise        Int
  hsn             String               @default("6211")
  weave           String
  fabric          String
  work            String
  occasion        String
  color           String
  colorSecondary  String?
  motif           String?
  border          String?
  pallu           String?
  lengthMeters    Float                @default(5.5)
  blousePiece     Boolean              @default(true)
  blouseLengthM   Float                @default(0.8)
  weightFeel      String
  transparency    String               @default("opaque")
  care            String
  modelHeightCm   Int?
  modelBlouseSize String?
  drapeVideoUrl   String?
  inStock         Boolean              @default(true)
  madeToOrder     Boolean              @default(false)
  leadDays        Int                  @default(0)
  featured        Boolean              @default(false)
  published       Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  images          ProductImage[]
  variants        ProductVariant[]
  collections     CollectionProduct[]
  wishlist        WishlistItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  pairWith        ProductPairing[]     @relation("ProductPairs")
  pairedFrom      ProductPairing[]     @relation("PairedProducts")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
  kind      String  @default("gallery")
}

model ProductVariant {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  sku          String     @unique
  color        String?
  blouseSize   String?
  stock        Int        @default(0)
  pricePaise   Int?
  cartItems    CartItem[]
  orderItems   OrderItem[]
}

model ProductPairing {
  id          String  @id @default(cuid())
  productId   String
  pairedId    String
  product     Product @relation("ProductPairs", fields: [productId], references: [id], onDelete: Cascade)
  paired      Product @relation("PairedProducts", fields: [pairedId], references: [id], onDelete: Cascade)

  @@unique([productId, pairedId])
}

model CollectionProduct {
  collectionId String
  productId    String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Addon {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String
  pricePaise  Int
  sku         String @unique
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  token     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  addons    String          @default("[]")
  note      String?

  @@unique([cartId, productId, variantId, addons])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String?
  token     String?
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([token, productId])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  type           String
  value          Int
  minSubtotal    Int       @default(0)
  maxDiscount    Int?
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean   @default(true)
  usageLimit     Int?
  usedCount      Int       @default(0)
  orders         Order[]
}

model Order {
  id               String          @id @default(cuid())
  number           String          @unique
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email            String
  phone            String
  status           String          @default("PENDING")
  paymentStatus    String          @default("UNPAID")
  paymentMethod    String
  gateway          String
  gatewayOrderId   String?
  gatewayPaymentId String?
  subtotalPaise    Int
  discountPaise    Int             @default(0)
  shippingPaise    Int             @default(0)
  taxPaise         Int             @default(0)
  cgstPaise        Int             @default(0)
  sgstPaise        Int             @default(0)
  igstPaise        Int             @default(0)
  codFeePaise      Int             @default(0)
  totalPaise       Int
  couponId         String?
  coupon           Coupon?         @relation(fields: [couponId], references: [id])
  couponCode       String?
  gstin            String?
  invoiceNumber    String?
  shippingName     String
  shippingPhone    String
  shippingLine1    String
  shippingLine2    String?
  shippingCity     String
  shippingState    String
  shippingPincode  String
  shippingCountry  String          @default("IN")
  addressId        String?
  address          Address?        @relation(fields: [addressId], references: [id])
  notes            String?
  trackingNumber   String?
  trackingUrl      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            OrderItem[]
  events           OrderEvent[]
  payments         Payment[]
  returnRequests   ReturnRequest[]
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  name         String
  sku          String
  hsn          String
  quantity     Int
  unitPaise    Int
  addons       String          @default("[]")
  note         String?
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  createdAt DateTime @default(now())
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amountPaise Int
  status      String
  gateway     String
  raw         String   @default("{}")
  createdAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  title      String
  body       String
  photoUrl   String?
  verified   Boolean  @default(true)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model JournalPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  body        String
  image       String
  publishedAt DateTime @default(now())
}

model Banner {
  id       String  @id @default(cuid())
  title    String
  subtitle String
  image    String
  href     String
  active   Boolean @default(true)
  sort     Int     @default(0)
}

model MeasurementProfile {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String  @default("Primary")
  bust      String?
  waist     String?
  hip       String?
  blouseLength String?
  notes     String?
}

model ReturnRequest {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  reason    String
  photoUrl  String?
  status    String   @default("REQUESTED")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  meta      String   @default("{}")
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
